{
  "name": "terminal-portfolio-template",
  "version": "1.0.0",
  "description": "Terminal-style personal homepage template",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint js/main.js js/commands.js js/render.js js/github.js js/theme.js terminal-config.js scripts tests playwright.config.js",
    "lint:fix": "npm run lint -- --fix",
    "build": "node scripts/build.mjs",
    "check:generated": "node scripts/build.mjs --check",
    "dev": "npm run build && python3 -m http.server 4030 --bind 127.0.0.1 --directory dist",
    "test:browser": "playwright test"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^9.15.0",
    "@playwright/test": "^1.65.1",
    "eslint": "^9.15.0",
    "globals": "^15.12.0",
    "jsdom": "^25.0.0",
    "vitest": "^5.1.0"
  }
}
